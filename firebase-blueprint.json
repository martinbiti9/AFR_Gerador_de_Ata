{
  "entities": {
    "User": {
      "title": "User",
      "description": "Usuário autorizado e perfil de controle de acesso (RBAC)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["member", "admin"] },
        "domain": { "type": "string" },
        "provider": { "type": "string" },
        "isActive": { "type": "boolean" },
        "mustChangePassword": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "passwordChangedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role", "domain", "isActive", "mustChangePassword"]
    },
    "Meeting": {
      "title": "Meeting",
      "description": "Dados da reunião, checklist, propostas, divergências e atas geradas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "obraCodigo": { "type": "string" },
        "obraNome": { "type": "string" },
        "assunto": { "type": "string" },
        "fornecedor": { "type": "string" },
        "servico": { "type": "string" },
        "rm": { "type": "string" },
        "cot": { "type": "string" },
        "step": { "type": "number" },
        "aiContext": { "type": "object" },
        "aiDivergences": { "type": "array" },
        "meetingTranscript": { "type": "string" },
        "finalAtaData": { "type": "object" },
        "sonnetAnalysis": { "type": "string" },
        "status": { "type": "string" },
        "ownerUid": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "ownerName": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "AtaState": {
      "title": "AtaState",
      "description": "Instantâneo versionado de estado da Ata com rastreabilidade de modelo, prompt e template",
      "type": "object",
      "properties": {
        "versao": { "type": "number" },
        "promptVersion": { "type": "string" },
        "modelo": { "type": "string" },
        "templateVersion": { "type": "number" },
        "savedAt": { "type": "string" },
        "savedBy": { "type": "object" },
        "status": { "type": "string" },
        "state": { "type": "object" }
      },
      "required": ["versao", "promptVersion", "modelo", "templateVersion", "savedAt", "status", "state"]
    },
    "TemplateVersion": {
      "title": "TemplateVersion",
      "description": "Versões de template DOCX com schema e chunks para geração determinística de atas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "number" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "companyName": { "type": "string" },
        "docxBlobBase64": { "type": "string" },
        "chunksCount": { "type": "number" },
        "docxBlobChunks": { "type": "array" },
        "schema": { "type": "object" },
        "detectedPlaceholders": { "type": "array" },
        "structureSummary": { "type": "string" },
        "isActive": { "type": "boolean" },
        "originalFileName": { "type": "string" },
        "fileSizeBytes": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Configurações de modelos de IA e prompts personalizados",
      "type": "object",
      "properties": {
        "models": { "type": "string" },
        "prompts": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Logs de auditoria e operações de IA",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string" },
        "level": { "type": "string" },
        "category": { "type": "string" },
        "message": { "type": "string" },
        "actorUid": { "type": "string" },
        "actorEmail": { "type": "string" },
        "actorRole": { "type": "string" },
        "details": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "Perfis de usuários, roles e status de troca de senha"
    },
    "/meetings/{meetingId}": {
      "schema": "Meeting",
      "description": "Coleção de atas e reuniões salvas no histórico com controle de proprietário"
    },
    "/meetings/{meetingId}/ataState/{versao}": {
      "schema": "AtaState",
      "description": "Subcoleção com snapshots versionados de estado e auditoria da ata"
    },
    "/templates/{templateId}": {
      "schema": "TemplateVersion",
      "description": "Coleção de templates de Pré-Ata e Ata"
    },
    "/config/{configId}": {
      "schema": "SystemConfig",
      "description": "Coleção de configurações globais do sistema"
    },
    "/logs/{logId}": {
      "schema": "AuditLog",
      "description": "Coleção de logs de auditoria"
    }
  }
}
