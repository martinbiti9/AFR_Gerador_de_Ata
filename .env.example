# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SONNET_API_KEY: Optional direct API key for Anthropic Sonnet 5 processing.
SONNET_API_KEY="MY_SONNET_API_KEY"

# Vertex AI Configuration for Anthropic Claude / Sonnet 5
GCP_PROJECT_ID="biti9-performevaluationsummary"
GCP_REGION="global"
CLAUDE_MODEL="claude-sonnet-5"
# GCP_SERVICE_ACCOUNT_KEY: Service Account JSON string for Vertex AI authentication
GCP_SERVICE_ACCOUNT_KEY="{}"

# Firebase Admin SDK (reutiliza a service account do Vertex AI)
FIREBASE_PROJECT_ID="biti9-performevaluationsummary"
FIRESTORE_DATABASE_ID="ai-studio-495e4a2f-bc01-4197-9d3d-8b17577710a2"
ALLOWED_ADMIN_DOMAIN="biti9.com.br"
ALLOWED_MEMBER_DOMAIN="afonsofranca.com.br"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

